+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    pub(super) fn credential(claim_change: impl FnOnce(&mut Value)) -> Value {
+        let mut claims = json!({
+            "iss": "https://auth.openai.com",
+            "aud": ["https://api.openai.com/v1"],
+            "exp": time::OffsetDateTime::now_utc().unix_timestamp() + 3600,
+            "scp": ["api.connectors.read", "api.connectors.invoke"],
+            "https://api.openai.com/auth": {"chatgpt_account_id": "account-a"}
+        });
+        claim_change(&mut claims);
+        let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+        json!({"type":"codex", "disabled":false, "account_id":"account-a",
+            "expired":"2099-01-01T00:00:00Z", "access_token":format!("e30.{payload}.c2ln")})
+    }
+
+    #[test]
+    fn valid_remote_uses_jwt_expiry_not_truthy_date_string() {
+        let auth = parse(credential(|_| {}).to_string().as_bytes()).expect("valid credential");
+        assert_eq!(auth.account_id, "account-a");
+    }
+
+    #[test]
+    fn rejects_invalid_issuer_audience_expiry_and_scopes() {
+        for (key, value) in [
+            ("iss", json!("https://example.invalid")),
+            ("aud", json!(["wrong-audience"])),
+            ("exp", json!(0)),
+            ("exp", Value::Null),
+            ("scp", json!(["codex.remote_control.enroll"])),
+        ] {
+            let value = credential(|claims| claims[key] = value);
+            assert!(parse(value.to_string().as_bytes()).is_err(), "{key}");
+        }
+    }
+
+    #[test]
+    fn rejects_disabled_mismatched_and_missing_tokens() {
+        for (key, value) in [
+            ("disabled", json!(true)),
+            ("disabled", json!("false")),
+            ("account_id", json!("another-account")),
+            ("type", json!("api_key")),
+            ("access_token", Value::Null),
+            ("access_token", json!("malformed")),
+        ] {
+            let mut remote = credential(|_| {});
+            remote[key] = value;
+            assert!(parse(remote.to_string().as_bytes()).is_err(), "{key}");
+        }
+    }
+
