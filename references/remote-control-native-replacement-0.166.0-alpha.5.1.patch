+        let (auth, authenticated) = super::super::RemoteControlAuth::capture(manager.clone());
+        assert!(authenticated);
+        assert!(auth.isolated.is_some());
+        assert!(manager.auth_cached().expect("main auth").is_api_key_auth());
+        assert!(!temp.path().join("auth.json").exists());
+        assert_eq!(auth.network_policy, manager.application_network_policy());
+        let connection = super::super::load_remote_control_auth(&auth)
+            .await
+            .expect("load remote auth");
+        assert_eq!(connection.account_id, "account-a");
+        let mut recovery = auth.unauthorized_recovery();
+        let mut changes = manager.auth_change_receiver();
+        assert!(!super::super::recover_remote_control_auth(&mut recovery, &mut changes).await);
+        assert!(
