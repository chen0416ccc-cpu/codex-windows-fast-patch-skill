+    #[cfg(windows)]
+    #[tokio::test]
+    async fn isolated_connection_preserves_network_denial_and_revocation() {
+        use codex_http_client::DestinationPolicy;
+        use codex_http_client::HttpClientFactory;
+        use codex_http_client::NetworkPolicyController;
+        use codex_http_client::OutboundProxyPolicy;
+        let temp = tempfile::tempdir().expect("temp directory");
+        std::fs::write(
+            temp.path().join("remote.json"),
+            credential(|_| {}).to_string(),
+        )
+        .expect("write remote fixture");
+        let controller = NetworkPolicyController::default();
+        let policy = controller.policy();
+        assert!(controller.publish(
+            policy.revision(),
+            DestinationPolicy::Restricted {
+                allowed_hosts: ["chatgpt.com".to_owned()].into_iter().collect(),
+            }
+        ));
+        let manager = Arc::new(
+            codex_login::AuthManager::new(
