+        let network = connection.http_client_factory.network_policy();
+        assert!(
+            network
+                .acquire(&"https://denied.example.invalid/".parse().expect("URL"))
+                .is_err()
+        );
+        let permit = network
+            .acquire(&"https://chatgpt.com/".parse().expect("URL"))
+            .expect("allowed host");
+        policy.invalidate();
+        assert!(permit.check().is_err());
+        assert!(
+            network
+                .acquire(&"https://chatgpt.com/".parse().expect("URL"))
+                .is_err()
+        );
+    }
+}
