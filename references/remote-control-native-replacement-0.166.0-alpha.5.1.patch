@@ -0,0 +1,277 @@
+//! Read-only credentials for remote transport, never a replacement main login.
+
+use base64::Engine;
+use codex_api::SharedAuthProvider;
+use codex_model_provider::BearerAuthProvider;
+use serde_json::Value;
+use std::io;
+use std::sync::Arc;
+
+pub(super) struct IsolatedRemoteAuth {
+    pub(super) auth_provider: SharedAuthProvider,
+    pub(super) account_id: String,
+    pub(super) expires_at: i64,
+}
+
+fn denied(reason: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, reason)
+}
+
+pub(super) fn parse(bytes: &[u8]) -> io::Result<IsolatedRemoteAuth> {
+    if bytes.len() > 1024 * 1024 {
+        return Err(denied("isolated remote credential exceeds size limit"));
+    }
+    let remote: Value = serde_json::from_slice(bytes)
+        .map_err(|_| denied("isolated remote credential is not valid JSON"))?;
+    if remote
+        .get("disabled")
+        .is_some_and(|v| v != &Value::Bool(false))
+        || remote.get("type").and_then(Value::as_str) != Some("codex")
+    {
+        return Err(denied(
+            "isolated remote credential is disabled or has an unsupported type",
+        ));
+    }
+    let token = remote
+        .get("access_token")
+        .and_then(Value::as_str)
+        .filter(|token| !token.is_empty())
+        .ok_or_else(|| denied("isolated remote access token is missing"))?;
+    let parts: Vec<_> = token.split('.').collect();
+    if parts.len() != 3 || parts.iter().any(|part| part.is_empty()) {
+        return Err(denied("isolated remote access token is not a JWT"));
+    }
+    let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(parts[1])
+        .map_err(|_| denied("isolated remote JWT payload is malformed"))?;
+    let claims: Value = serde_json::from_slice(&payload)
+        .map_err(|_| denied("isolated remote JWT claims are malformed"))?;
+    if claims.get("iss").and_then(Value::as_str) != Some("https://auth.openai.com") {
+        return Err(denied("isolated remote JWT issuer is not supported"));
+    }
+    let audience_ok = match claims.get("aud") {
+        Some(Value::String(aud)) => aud == "https://api.openai.com/v1",
+        Some(Value::Array(aud)) => aud
+            .iter()
+            .any(|v| v.as_str() == Some("https://api.openai.com/v1")),
+        _ => false,
+    };
+    if !audience_ok {
+        return Err(denied("isolated remote JWT audience is not supported"));
+    }
+    let expires_at = claims
+        .get("exp")
+        .and_then(Value::as_i64)
+        .filter(|exp| *exp > time::OffsetDateTime::now_utc().unix_timestamp())
+        .ok_or_else(|| denied("isolated remote JWT is expired or has no expiry"))?;
+    let scopes = claims.get("scp").or_else(|| claims.get("scope"));
+    let has_scope = |required: &str| match scopes {
+        Some(Value::Array(values)) => values.iter().any(|v| v.as_str() == Some(required)),
+        Some(Value::String(values)) => values.split_ascii_whitespace().any(|v| v == required),
+        _ => false,
+    };
+    if !has_scope("api.connectors.read") || !has_scope("api.connectors.invoke") {
+        return Err(denied(
+            "isolated remote JWT lacks connection scopes; enroll-only tokens are not read credentials",
+        ));
+    }
+    let account_id = claims
+        .get("https://api.openai.com/auth")
+        .and_then(|auth| {
+            auth.get("chatgpt_account_id")
+                .or_else(|| auth.get("account_id"))
+        })
+        .and_then(Value::as_str)
+        .filter(|id| !id.is_empty())
+        .ok_or_else(|| denied("isolated remote JWT has no account id"))?;
+    if remote
+        .get("account_id")
+        .is_some_and(|value| value.as_str() != Some(account_id))
+    {
+        return Err(denied("isolated remote account does not match JWT account"));
+    }
+    // These checks are admission checks, not signature verification; the official backend
+    // verifies the bearer. No token or refresh secret is logged or persisted here.
+    axum::http::HeaderValue::from_str(&format!("Bearer {token}"))
+        .map_err(|_| denied("isolated remote bearer is not a valid HTTP header"))?;
+    axum::http::HeaderValue::from_str(account_id)
+        .map_err(|_| denied("isolated remote account is not a valid HTTP header"))?;
+    Ok(IsolatedRemoteAuth {
+        auth_provider: Arc::new(BearerAuthProvider {
+            token: Some(token.to_owned()),
+            account_id: Some(account_id.to_owned()),
+            is_fedramp_account: false,
+        }),
+        account_id: account_id.to_owned(),
+        expires_at,
+    })
+}
