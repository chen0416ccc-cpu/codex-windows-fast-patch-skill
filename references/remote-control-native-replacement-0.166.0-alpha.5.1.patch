+                codex_login::AuthKeyringBackendKind::default(),
+                codex_login::AuthRouteConfig::from_http_client_factory(
+                    HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)
+                        .with_network_policy(policy.clone()),
+                ),
